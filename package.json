{
  "name": "@duta/sdk",
  "version": "0.2.0",
  "description": "The official Node.js SDK for Duta, transactional email for Malaysia.",
  "license": "MIT",
  "author": "Duta",
  "homepage": "https://docs.duta.indra.sh/sdks/",
  "repository": {
    "type": "git",
    "url": "https://github.com/indra-sh/duta-js.git"
  },
  "bugs": {
    "url": "https://github.com/indra-sh/duta-js/issues"
  },
  "keywords": [
    "duta",
    "email",
    "transactional-email",
    "malaysia",
    "resend-alternative"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
